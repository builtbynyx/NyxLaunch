<Window x:Class="NyxLaunch.App.ArgumentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Launch options" Width="520" Height="285" MinWidth="480" MinHeight="270"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" WindowStyle="None"
        Background="#090A0F" Foreground="#F2F3F8" FontFamily="Segoe UI">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="5" CornerRadius="9" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Grid Background="#090A0F">
    <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Background="#11111A">
      <TextBlock Text="NYXLAUNCH  /  LAUNCH OPTIONS" FontSize="10" FontWeight="Bold" Foreground="#C8C0F2" VerticalAlignment="Center" Margin="16,0,0,0" IsHitTestVisible="False"/>
      <Button Content="×" Width="44" HorizontalAlignment="Right" Click="CloseWindow_Click" Background="Transparent" BorderThickness="0" Foreground="#AAA6B8" FontSize="19" Padding="0" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
    </Grid>
    <Grid Grid.Row="1" Margin="23,19,23,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="GameTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Grid.Row="1" Text="Arguments are passed directly to the game's executable when launched." Foreground="#9298AA" TextWrapping="Wrap" FontSize="11" Margin="0,7,0,15"/>
      <TextBox x:Name="ArgumentsBox" Grid.Row="2" MinHeight="38" VerticalContentAlignment="Center"/>
      <TextBlock Grid.Row="3" Text="Example: -windowed -novid" Foreground="#777D8E" FontSize="10" Margin="0,8,0,0"/>
      <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,17,0,0">
        <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,9,0" MinWidth="90"/>
        <Button Content="Save arguments" Background="#6555B4" BorderBrush="#8272D8" Click="Save_Click" MinWidth="125"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>