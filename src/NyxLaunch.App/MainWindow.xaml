<Window x:Class="NyxLaunch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NyxLaunch" Height="850" Width="1440" MinHeight="680" MinWidth="1060"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#08090E" Foreground="#F4F3FA" FontFamily="Segoe UI" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="10" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#9291A5"/>
    <SolidColorBrush x:Key="Line" Color="#242332"/>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Foreground" Value="#A8A6B8"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,12"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border>
          <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#1B1928"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button"><Setter Property="Foreground" Value="#F5F3FF"/><Setter Property="Background" Value="#191825"/><Setter Property="BorderBrush" Value="#302D43"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="15,10"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#29243D"/><Setter TargetName="b" Property="BorderBrush" Value="#7664C8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="#F4F3FA"/><Setter Property="Background" Value="#12121B"/><Setter Property="BorderBrush" Value="#292737"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="13,10"/><Setter Property="FontSize" Value="12"/><Setter Property="CaretBrush" Value="#A99BFF"/></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/></Style>
    <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,12,14"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="CardBorder" Background="#11111A" BorderBrush="#242332" BorderThickness="1" CornerRadius="12"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardBorder" Property="BorderBrush" Value="#6555A7"/><Setter TargetName="CardBorder" Property="Background" Value="#171522"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="CardBorder" Property="BorderBrush" Value="#9B88F5"/><Setter TargetName="CardBorder" Property="Background" Value="#1C192A"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="GameCardGrid" TargetType="Grid"><Setter Property="Height" Value="148"/><Style.Triggers><DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBox}}, Path=Tag}" Value="Recent"><Setter Property="Height" Value="124"/></DataTrigger></Style.Triggers></Style>
  </Window.Resources>
  <Grid Background="#08090E">
    <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <!-- Custom Nyx title bar -->
    <Grid Grid.Row="0" Background="#0D0D15">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/><ColumnDefinition Width="42"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" IsHitTestVisible="False">
        <Border Width="21" Height="21" CornerRadius="6" Background="#28223F" BorderBrush="#51447E" BorderThickness="1">
          <TextBlock Text="N" Foreground="#B6A8FF" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="NYXLAUNCH" FontSize="11" FontWeight="Bold" Foreground="#E9E6F5" VerticalAlignment="Center" Margin="9,0,0,0"/>
        <TextBlock Text=" / YOUR GAME SPACE" FontSize="9" Foreground="#777489" VerticalAlignment="Center" Margin="7,1,0,0"/>
      </StackPanel>
      <Button Grid.Column="1" Content="—" Click="Minimize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" Background="Transparent" BorderThickness="0" Foreground="#A7A3B5" FontSize="14" Padding="0"/>
      <Button Grid.Column="2" Content="□" Click="Restore_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" Background="Transparent" BorderThickness="0" Foreground="#A7A3B5" FontSize="13" Padding="0"/>
      <Button Grid.Column="3" Content="×" Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" Background="Transparent" BorderThickness="0" Foreground="#A7A3B5" FontSize="19" Padding="0"/>
    </Grid>
    <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="214"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <!-- Sidebar -->
    <Border Grid.Column="0" Background="#0D0D15" BorderBrush="#22212E" BorderThickness="0,0,1,0">
      <DockPanel Margin="17,22,17,18">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="4,3,0,42">
            <Border Width="38" Height="38" CornerRadius="12" Background="#28223F" BorderBrush="#51447E" BorderThickness="1"><TextBlock Text="N" Foreground="#B6A8FF" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="NYXLAUNCH" FontSize="15" FontWeight="Bold"/><TextBlock Text="YOUR GAME SPACE" FontSize="8" Foreground="#777489" Margin="0,3,0,0"/></StackPanel>
          </StackPanel>
          <TextBlock Text="WORKSPACE" FontSize="9" FontWeight="Bold" Foreground="#777489" Margin="10,0,0,11"/>
          <Button x:Name="AllGamesButton" Style="{StaticResource NavButton}" Content="▦     Discover library" Background="#211D32" Foreground="#D7CEFF" Click="AllGames_Click"/>
          <Button x:Name="RecentButton" Style="{StaticResource NavButton}" Content="◷     Recently played" Margin="0,4,0,0" Click="Recent_Click"/>
          <TextBlock Text="PLATFORMS" FontSize="9" FontWeight="Bold" Foreground="#777489" Margin="10,25,0,11"/>
          <Button x:Name="SteamButton" Style="{StaticResource NavButton}" Content="◉     Steam" Click="Steam_Click"/>
          <Grid Margin="10,29,0,11">
            <TextBlock Text="COLLECTIONS" FontSize="9" FontWeight="Bold" Foreground="#777489" VerticalAlignment="Center"/>
            <Button Content="＋" Width="24" Height="22" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Create collection" Click="CreateCollection_Click"/>
          </Grid>
          <ItemsControl x:Name="CollectionsList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource NavButton}" Content="{Binding}" Tag="{Binding}" Click="Collection_Click" Loaded="CollectionNavButton_Loaded" Margin="0,1,0,1"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Style="{StaticResource NavButton}" Content="＋     Add a game" Margin="0,12,0,0" Click="AddGame_Click"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="4,0,4,0">
          <Border Height="1" Background="#242332" Margin="0,0,0,15"/>
          <TextBlock Text="BUILT BY NYX" FontSize="9" FontWeight="Bold" Foreground="#8C83B8"/>
          <TextBlock Text="NyxLaunch  •  v0.3.0" FontSize="10" Foreground="#777489" Margin="0,5,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <!-- Main content -->
    <Grid Grid.Column="1" Margin="28,23,28,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="178"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,20">
        <StackPanel><TextBlock x:Name="PageTitle" Text="Your library" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="All your PC games, together at last." Foreground="#9291A5" FontSize="11" Margin="0,5,0,0"/></StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="↻  Sync Steam" Click="ScanSteam_Click" Margin="0,0,8,0"/><Button Content="＋  Add game" Background="#6555B4" BorderBrush="#8977E0" Click="AddGame_Click"/></StackPanel>
      </Grid>
      <!-- Featured game banner -->
      <Border Grid.Row="1" CornerRadius="15" BorderBrush="#39314F" BorderThickness="1" Background="#171522" ClipToBounds="True">
        <Grid>
          <Image x:Name="HeroArtwork" Stretch="UniformToFill" Opacity="0.30" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
          <Border Background="#C9080910"/>
          <Border Background="#5A171324"/>
          <StackPanel VerticalAlignment="Center" Margin="25,0,25,0">
            <TextBlock Text="PICK UP WHERE YOU LEFT OFF" FontSize="9" FontWeight="Bold" Foreground="#B9AFFF"/>
            <TextBlock x:Name="HeroTitle" Text="Your next session starts here." FontSize="23" FontWeight="SemiBold" Margin="0,9,0,4"/>
            <TextBlock x:Name="HeroSubtitle" Text="Choose a game from your library to see its details." FontSize="11" Foreground="#B4B0C5"/>
            <Button x:Name="HeroPlayButton" Content="▶   Play selected game" HorizontalAlignment="Left" Margin="0,15,0,0" Padding="17,9" Background="#6D5BC0" BorderBrush="#927FE9" Click="Play_Click" IsEnabled="False"/>
          </StackPanel>
          <TextBlock Text="NYX / PLAY" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,17" FontSize="9" FontWeight="Bold" Foreground="#77718F"/>
        </Grid>
      </Border>
      <!-- Search and count -->
      <Grid Grid.Row="2" Margin="0,21,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="YOUR GAMES" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="GameCount" Text="0 TITLES" FontSize="9" Foreground="#858297" Margin="10,2,0,0"/></StackPanel>
        <Border Grid.Column="1" Width="292" Height="40" CornerRadius="11" Background="#11111A" BorderBrush="#302D43" BorderThickness="1" VerticalAlignment="Center">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="39"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="⌕" FontSize="23" Foreground="#9189B8" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0" IsHitTestVisible="False"/>
            <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0,1,12,0" VerticalContentAlignment="Center" FontSize="12" ToolTip="Search your game library" TextChanged="SearchBox_TextChanged"/>
            <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="Search your games..." Foreground="#777489" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False" Margin="0,0,0,1"/>
          </Grid>
        </Border>
      </Grid>
      <!-- Game cards and profile -->
      <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="265"/></Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="0,0,18,0">
          <ListBox x:Name="GamesList" Tag="All" SelectionChanged="GamesList_SelectionChanged">
            <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemTemplate><DataTemplate>
              <Grid Width="Auto" Style="{StaticResource GameCardGrid}" ClipToBounds="True">
                <Grid.RowDefinitions><RowDefinition Height="94"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Grid.RowSpan="2" Background="#14131E" CornerRadius="11"/>
                <Grid Grid.Row="0" ClipToBounds="True">
                  <Image Source="{Binding CoverImageUrl}" Stretch="UniformToFill"/>
                  <Border Background="#45080910"/>
                  <Border Background="#241B1830" VerticalAlignment="Bottom" Height="38"/>
                  <TextBlock Text="{Binding PlatformBadgeText}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,10,0" FontSize="8" FontWeight="Bold" Foreground="#F0EDFF" Background="#99100F19" Padding="7,4"/>
                </Grid>
                <StackPanel Grid.Row="1" Margin="11,8,10,8" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding PlaytimeText}" FontSize="9" Foreground="#9692A8" Margin="0,4,0,0"/>
                </StackPanel>
              </Grid>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"><TextBlock Text="No games found" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Try another search, scan Steam, or add a game." Foreground="#9291A5" FontSize="11" Margin="0,7,0,0" HorizontalAlignment="Center"/><Button Content="＋  Add a game" Margin="0,15,0,0" Background="#6555B4" Click="AddGame_Click"/></StackPanel>
        </Grid>
        <!-- Selected game profile -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Focusable="False">
        <Border Background="#11111A" BorderBrush="#292737" BorderThickness="1" CornerRadius="14" Padding="17" Margin="0,0,0,3">
          <StackPanel>
            <TextBlock Text="NOW SELECTED" FontSize="9" FontWeight="Bold" Foreground="#9A91C8"/>
            <Border Height="105" CornerRadius="9" Background="#211D32" Margin="0,12,0,14" ClipToBounds="True"><Grid><Image x:Name="DetailArtwork" Stretch="UniformToFill"/><TextBlock x:Name="DetailGlyph" Text="N" FontSize="32" FontWeight="Bold" Foreground="#A99BFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
            <TextBlock x:Name="DetailName" Text="Choose a game" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="DetailPlatform" Text="Select a title to view its profile." Foreground="#9291A5" FontSize="10" Margin="0,5,0,13"/>
            <Border Height="1" Background="#292737" Margin="0,0,0,12"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,9,0"><TextBlock Text="PLAYTIME" FontSize="8" Foreground="#858297"/><TextBlock x:Name="DetailPlaytime" Text="—" FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
              <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="LAST PLAYED" FontSize="8" Foreground="#858297"/><TextBlock x:Name="DetailLastPlayed" Text="—" FontSize="10" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
            </Grid>
            <TextBlock Text="INSTALL LOCATION" FontSize="8" Foreground="#858297" Margin="0,15,0,4"/><TextBlock x:Name="DetailPath" Text="—" Foreground="#AAA7B8" FontSize="9" TextWrapping="Wrap" MaxHeight="42"/>
            <Button x:Name="AddToCollectionButton" Content="＋    Add to collection" Margin="0,13,0,0" Click="AddToCollection_Click" IsEnabled="False"/>
            <Button x:Name="PlayButton" Content="▶    Launch game" Background="#6555B4" BorderBrush="#8977E0" Margin="0,15,0,0" Click="Play_Click" IsEnabled="False"/>
            <Button x:Name="ArgumentsButton" Content="⚙    Launch options" Margin="0,7,0,0" Click="Arguments_Click" IsEnabled="False"/>
            <Button x:Name="RemoveButton" Content="Remove from library" Background="Transparent" BorderBrush="Transparent" Foreground="#B18A9B" Margin="0,5,0,0" Click="Remove_Click" IsEnabled="False"/>
          </StackPanel>
        </Border>
        </ScrollViewer>
      </Grid>
      <TextBlock Grid.Row="4" Text="Your library stays on this device. NyxLaunch never uploads your game list." Foreground="#69677A" FontSize="9" Margin="0,12,0,0"/>
    </Grid>
    </Grid>
  </Grid>
</Window>